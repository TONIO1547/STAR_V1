# Copier vers /etc/star-device.env (root:root, mode 0600).
# Jeton partage entre le site et la Jetson : device_auth.py l'exige sur chaque
# route Flask (en-tete "Authorization: Bearer ..."). 32 caracteres minimum,
# sinon le service refuse de demarrer.
# Generer une valeur neuve avec : openssl rand -hex 32
STAR_DEVICE_TOKEN=remplacer-par-un-jeton-aleatoire-de-64-caracteres-hex
