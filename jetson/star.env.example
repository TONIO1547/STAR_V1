# Copier vers /etc/star.env (root:root, mode 0600).
# Ces trois variables sont ecrites automatiquement par :
#     sudo python3 star_auth.py --configure
# Le mot de passe en clair n'est jamais stocke : seul son hachage
# PBKDF2-SHA256 (600 000 iterations) l'est.
STAR_USERNAME=mon-identifiant
STAR_PASSWORD_HASH=pbkdf2_sha256$600000$<sel_base64>$<hachage_base64>
STAR_SECRET_KEY=remplacer-par-openssl-rand-hex-32

# Chemin du moteur TensorRT et seuil de confiance initial (optionnels :
# stream_drone_pid.py a ses propres valeurs par defaut).
# STAR_MODEL_PATH=new_best_v1.engine
# STAR_CONFIDENCE=0.25

# Port UART de la camera thermique (optionnel, desactive si absent).
# STAR_THERMAL_PORT=/dev/ttyTHS1
