# Copier vers /etc/star-tracking.env (root:root, mode 0600).
# Remplacer par l adresse affichee par l ESP32 sur le moniteur serie.
STAR_ESP32_IP=192.168.1.50
STAR_ESP32_PORT=4210
STAR_PID_CONFIG_PATH=/mnt/sdcard/yolov5/star_pid_config.json
STAR_MODEL_PATH=new_best_v1.engine
STAR_TENSORRT_FP16=1

# CAM01 Canon = USB 2.1, camera principale permanente et tracking prioritaire.
STAR_CANON_CAMERA=/dev/v4l/by-path/platform-70090000.xusb-usb-0:2.1:1.0-video-index0
# CAM02 Guet = USB 2.2, acquisition basse frequence uniquement.
STAR_GUET_CAMERA=/dev/v4l/by-path/platform-70090000.xusb-usb-0:2.2:1.0-video-index0
STAR_CANON_AI_SIZE=640
STAR_GUET_AI_SIZE=640

# Reglages du flux distant (ils ne changent pas la resolution YOLO).
STAR_STREAM_MAX_FPS=6
STAR_STREAM_JPEG_QUALITY=55
STAR_STREAM_MAX_WIDTH=512
STAR_STREAM_MAX_HEIGHT=384
STAR_GUET_INFERENCE_HZ=2
# 0 = cadence Canon maximale, sans limite artificielle.
STAR_CANON_INFERENCE_HZ=0
STAR_CONTROL_LOOP_HZ=50
STAR_GUET_SERVO_HZ=20
STAR_GUET_PAN_SCAN_DPS=12
STAR_GUET_TILT_SCAN_DPS=5
STAR_HANDOFF_MIN_INTERVAL_S=0.15
STAR_HANDOFF_MIN_CONFIDENCE=0.40
STAR_METRICS_PRINT_INTERVAL_S=2

# Fusion CAM-01 / thermique.
STAR_FUSION_VISIBLE_ALPHA=0.25
STAR_FUSION_SCALE_X=1.0
STAR_FUSION_SCALE_Y=1.0
STAR_FUSION_OFFSET_X=0
STAR_FUSION_OFFSET_Y=0
